    height: auto;
    margin-top: 1;
}

#api-layout,
#pack-layout {
    height: 100%;
    padding: 1 2 0 2;
}

#pack-body-scroll {
    height: 1fr;
    scrollbar-size: 1 1;
}

#api-title,
#pack-title {
    color: #9da4ff;
    text-style: bold;
    height: 2;
    border-bottom: solid #25384b;
    margin-bottom: 1;
}

#api-status {
    color: #f0bd60;
    height: 1;
    margin-bottom: 1;
}

#pack-status {
    color: #f0bd60;
    height: auto;
    min-height: 1;
    margin-bottom: 1;
}

#api-body {
    height: 1fr;
    layout: horizontal;
}

#api-scenarios,
#api-runs,
#api-detail,
#pack-summary,
#pack-items {
    background: #0e1a26;
    border: round #29455f;
    color: #c1d4e4;
    padding: 1;
    overflow-y: auto;
}

#api-scenarios {
    width: 30;
}

#api-runs {
    width: 34;
    margin-left: 1;
}

#api-detail {
