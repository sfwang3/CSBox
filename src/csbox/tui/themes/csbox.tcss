Screen {
    background: #08111a;
    color: #dbe7f2;
}

#submission-layout {
    height: 100%;
    padding: 1 2 0 2;
}

#submission-title {
    color: #9da4ff;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#submission-scroll {
    height: 1fr;
    min-height: 1;
    padding: 1;
    background: #0e1a26;
    border: round #29455f;
    scrollbar-size: 1 1;
}

#submission-content {
    height: auto;
    color: #dbe7f2;
}

#submission-actions {
    height: 3;
    margin-top: 1;
}

#submission-actions Button {
    width: 1fr;
    margin-right: 1;
}

#submission-status {
    height: auto;
    min-height: 1;
    color: #f0bd60;
    margin-top: 1;
}

#submission-footer {
    height: 1;
    color: #a5bacd;
    margin-top: 1;
}

#home-layout {
    height: 100%;
    padding: 1 2 0 2;
}

#brand-block {
    height: auto;
    padding: 0 0 1 0;
    border-bottom: solid #25384b;
}

#brand-name {
    color: #8f95ff;
    text-style: bold;
    height: 1;
}

#brand-subtitle {
    color: #afc0d1;
    height: 1;
}

#home-greeting {
    color: #e7f0f8;
    margin-top: 1;
    height: 1;
}

#home-description {
    color: #8ea5b9;
    height: 1;
}

#home-quick-start {
    color: #86c8ae;
    height: auto;
    margin-top: 1;
}

#action-panel,
#project-panel,
#workflow-status-panel {
    background: #0e1a26;
    border: round #29455f;
    padding: 1;
}

.panel-title {
    color: #6fc7e8;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#main-scroll {
    height: 1fr;
    margin-top: 0;
    padding-bottom: 1;
    scrollbar-size: 1 1;
}

#content-grid {
    height: auto;
    layout: vertical;
    margin-top: 1;
}

#action-panel,
#home-context {
    height: auto;
    margin-bottom: 1;
}

#home-context {
    width: 100%;
}

#project-panel,
#workflow-status-panel {
    height: auto;
    margin-bottom: 1;
}

#home-project-path {
    color: #d7e6f3;
    height: auto;
}

#home-project-note {
    color: #70859a;
    height: 1;
    margin-top: 1;
}

#home-workflow-status {
    color: #bcd0e0;
    height: auto;
}

.entry-button {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    border: round #326fa2;
    background: #122335;
    color: #dbeeff;
}

.entry-button:hover {
    background: #19344c;
    color: #ffffff;
}

.entry-button:focus {
    border: round #969dff;
    text-style: bold;
}

.entry-card {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

.entry-card .entry-button {
    width: 18;
    height: 3;
    margin-bottom: 0;
}

.entry-description {
    width: 1fr;
    height: 3;
    padding: 0 1;
    content-align: left middle;
    color: #bcd0e0;
}

#shortcut-bar {
    height: 1;
    color: #a5bacd;
    background: #101e2b;
    padding: 0 1;
}

UnavailableDialog {
    align: center middle;
    background: rgba(0, 0, 0, 0.72);
}

#unavailable-dialog {
    width: 56;
    height: auto;
    border: round #6d79e8;
    background: #101c29;
    padding: 1 2;
}

#dialog-title {
    color: #9da4ff;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#dialog-message {
    color: #dbe7f2;
    height: auto;
    margin-bottom: 1;
}

#dialog-close {
    width: 100%;
    height: 3;
    border: round #326fa2;
    background: #162d43;
}

#dialog-close:focus {
    border: tall #f0bd60;
}

HelpDialog {
    align: center middle;
    background: #08111a;
}

#help-dialog {
    width: 76;
    max-width: 92%;
    height: 90%;
    max-height: 90%;
    border: round #6d79e8;
    background: #101c29;
    padding: 1 2;
}

#help-card {
    height: 100%;
}

#help-title {
    color: #9da4ff;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#help-scroll {
    height: 1fr;
    min-height: 1;
    scrollbar-size: 1 1;
    scrollbar-background: #101c29;
    scrollbar-background-hover: #162d43;
    scrollbar-background-active: #162d43;
    scrollbar-color: #326fa2;
    scrollbar-color-hover: #6d79e8;
    scrollbar-color-active: #969dff;
    overflow-y: auto;
}

#help-body {
    color: #dbe7f2;
    height: auto;
}

#help-close {
    width: 100%;
    height: 3;
    margin-top: 1;
    border: round #326fa2;
    background: #162d43;
}

#help-close:focus {
    border: round #f0bd60;
}

#help-footer {
    height: 1;
    color: #a5bacd;
    margin-top: 1;
}

.wide #content-grid {
    layout: horizontal;
    height: 1fr;
}

.wide #action-panel {
    width: 2fr;
    height: 1fr;
    margin-right: 1;
    margin-bottom: 0;
    overflow-y: auto;
}

.wide #action-panel .entry-card {
    margin-bottom: 0;
}

.wide #home-context {
    width: 3fr;
    height: 1fr;
    margin-bottom: 0;
}

LabStartDialog {
    align: center middle;
    background: rgba(0, 0, 0, 0.72);
}

#lab-start-dialog {
    width: 66;
    max-width: 92%;
    height: 23;
    max-height: 96%;
    border: round #6d79e8;
    background: #101c29;
    padding: 1 2;
}

#lab-start-card {
    height: 100%;
}

#lab-start-heading {
    color: #9da4ff;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#lab-start-fields {
    height: 1fr;
    scrollbar-size: 1 1;
}

.field-label {
    color: #8ea5b9;
    height: 1;
    margin-top: 1;
}

#lab-start-name,
#lab-start-shell-select {
    width: 100%;
}

#lab-start-shell-display,
#lab-start-project {
    color: #dbe7f2;
    height: 1;
}

#lab-start-advanced {
    width: 18;
    height: 3;
    margin-top: 0;
}

#lab-start-shell-select {
    height: 3;
}

#lab-start-hint {
    color: #86c8ae;
    height: auto;
    margin-top: 1;
}

#lab-start-validation {
    color: #f0bd60;
    height: auto;
    min-height: 1;
}

#lab-start-actions {
    height: 3;
    margin-top: 1;
}

#lab-start-confirm,
#lab-start-cancel {
    width: 1fr;
    height: 3;
}

#lab-start-confirm {
    margin-right: 1;
}

#review-layout {
    height: 100%;
    padding: 1 2 0 2;
}

#records-layout {
    height: 100%;
    padding: 1 2 0 2;
}

#evidence-list-layout,
#evidence-editor-layout {
    height: 100%;
    padding: 1 2 0 2;
}

#evidence-list-title,
#evidence-editor-title {
    color: #9da4ff;
    text-style: bold;
    height: 2;
}

#evidence-list-scroll {
    height: 1fr;
    background: #0e1a26;
    border: round #29455f;
    padding: 1;
    overflow-y: auto;
}

#evidence-list,
#evidence-list-message,
#evidence-item-detail,
#evidence-items,
#evidence-editor-message {
    color: #d7e6f3;
    height: auto;
}

#evidence-list-message,
#evidence-editor-message {
    color: #f0bd60;
    height: 2;
}

#evidence-list-actions,
#evidence-editor-actions {
    height: 3;
    align: right middle;
}

#evidence-list-actions Button,
#evidence-editor-actions Button {
    min-width: 10;
    height: 3;
}

#evidence-export {
    min-width: 16;
}

#evidence-list-footer,
#evidence-editor-footer {
    height: 1;
    color: #a5bacd;
}

#evidence-browser-layout {
    height: 100%;
    padding: 1 2 0 2;
}

#evidence-browser-title {
    color: #9da4ff;
    text-style: bold;
    height: 2;
    border-bottom: solid #25384b;
    margin-bottom: 1;
}

#evidence-browser-list {
    height: 1fr;
    background: #0e1a26;
    border: round #29455f;
    color: #d7e6f3;
    padding: 1;
    overflow-y: auto;
}

#evidence-browser-message {
    color: #f0bd60;
    height: auto;
    min-height: 1;
    margin-top: 1;
}

#evidence-browser-footer {
    height: 2;
    color: #a5bacd;
}

#evidence-set-dialog,
#evidence-item-dialog {
    align: center middle;
    background: rgba(0, 0, 0, 0.72);
}

#evidence-set-card,
#evidence-item-card {
    width: 70;
    max-width: 92%;
    max-height: 90%;
    height: auto;
    border: round #6d79e8;
    background: #101c29;
    padding: 1 2;
}

#evidence-item-card {
    overflow-y: auto;
}

#evidence-set-heading,
#evidence-item-heading {
    color: #9da4ff;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

.evidence-field-label {
    color: #8ea5b9;
    height: 1;
    margin-top: 1;
}

#evidence-item-title-input,
#evidence-item-caption-input,
#evidence-item-note-input {
    width: 100%;
}

#evidence-item-note-input {
    height: 7;
}

#evidence-set-title-error,
#evidence-item-error {
    color: #f0bd60;
    height: auto;
    min-height: 1;
    margin-top: 1;
}

#evidence-set-actions,
#evidence-item-actions {
    height: 3;
    align: right middle;
    margin-top: 1;
}

#evidence-set-actions Button,
#evidence-item-actions Button {
    min-width: 12;
    margin-left: 1;
}

#evidence-editor-body {
    height: 1fr;
    layout: horizontal;
}

#evidence-items,
#evidence-item-detail {
    width: 1fr;
    background: #0e1a26;
    border: round #29455f;
    padding: 1;
    overflow-y: auto;
}

#evidence-item-detail {
    margin-left: 1;
}

.narrow #evidence-editor-body {
    layout: vertical;
}

.narrow #evidence-item-detail {
    margin-left: 0;
    margin-top: 1;
}

#records-title {
    color: #9da4ff;
    text-style: bold;
    height: 2;
    border-bottom: solid #25384b;
    margin-bottom: 1;
}

#records-body {
    height: 1fr;
    layout: horizontal;
}

#records-list,
#records-detail,
#records-narrow {
    background: #0e1a26;
    border: round #29455f;
    color: #c1d4e4;
    padding: 1;
    overflow-y: auto;
}

#records-list {
    width: 2fr;
}

#records-detail {
    width: 3fr;
    margin-left: 1;
}

#records-narrow {
    display: none;
    height: 1fr;
}

#records-message {
    color: #f0bd60;
    height: 1;
    margin-top: 1;
}

#records-actions {
    height: 3;
    align: right middle;
}

#records-actions Button {
    min-width: 14;
    height: 3;
}

#records-review:focus,
#records-export:focus,
#records-start:focus {
    border: tall #f0bd60;
}

#records-footer {
    height: 1;
    color: #a5bacd;
    background: #101e2b;
    padding: 0 1;
    margin-top: 1;
}

.narrow #records-body {
    display: none;
}

.narrow #records-narrow {
    display: block;
}

.wide #records-narrow {
    display: none;
}

ExportDialog,
ExportOverwriteDialog,
ExportResultScreen,
ReportExportDialog,
ReportExportOverwriteDialog,
ReportExportResultScreen {
    align: center middle;
    background: rgba(0, 0, 0, 0.72);
}

ReportProfileDialog {
    align: center middle;
    background: rgba(0, 0, 0, 0.72);
}

#export-dialog,
#export-overwrite-dialog,
#export-result-dialog,
#report-export-dialog,
#report-overwrite-dialog,
#report-result-dialog {
    width: 70;
    max-width: 92%;
    height: auto;
    max-height: 96%;
    border: round #6d79e8;
    background: #101c29;
    padding: 1 2;
}

#export-dialog {
    height: 23;
}

#export-overwrite-dialog,
#export-result-dialog,
#report-overwrite-dialog,
#report-result-dialog {
    width: 76;
}

#export-heading,
#export-overwrite-heading,
#export-result-heading {
    color: #9da4ff;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#export-experiment,
#export-captures,
#export-theme-display {
    color: #dbe7f2;
    height: auto;
}

#export-captures {
