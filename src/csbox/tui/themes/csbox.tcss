    height: 3;
}

#export-validation {
    color: #f0bd60;
    height: auto;
    min-height: 1;
}

#export-restore-default {
    width: 18;
    height: 3;
    margin-top: 0;
}

#export-theme-select {
    width: 100%;
    height: 3;
}

#report-export-dialog {
    height: 17;
}

#report-overwrite-dialog {
    height: auto;
}

#report-result-dialog {
    height: 30;
}

#report-profile-dialog {
    width: 88;
    max-width: 94%;
    height: 90%;
    max-height: 96%;
}

#report-profile-card {
    height: 100%;
}

#report-profile-heading {
    color: #9da4ff;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#report-profile-hint {
    color: #86c8ae;
    height: auto;
    margin-bottom: 1;
}

#report-profile-fields {
    height: 1fr;
    overflow-y: auto;
    scrollbar-size: 1 1;
}

.report-profile-field-label {
    color: #8ea5b9;
    height: 1;
    margin-top: 1;
}

.report-profile-section {
    height: auto;
    border-top: solid #29455f;
    padding-top: 1;
    margin-top: 1;
}

.report-profile-section-title {
    color: #6fc7e8;
    text-style: bold;
    height: 1;
}

#report-profile-card Input,
#report-profile-card TextArea {
    width: 100%;
}

#report-profile-card TextArea {
    height: 5;
}

#report-profile-error {
    color: #f0bd60;
    height: auto;
    min-height: 1;
    margin-top: 1;
}

#report-profile-actions {
    height: 3;
    align: right middle;
    margin-top: 1;
}

#report-profile-actions Button {
    min-width: 14;
    height: 3;
}

#report-profile-save {
    margin-right: 1;
}

#report-export-heading,
#report-overwrite-heading,
#report-result-heading {
    color: #9da4ff;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#report-export-hint,
#report-overwrite-message,
#report-result-body,
#report-result-artifacts {
    color: #dbe7f2;
    height: auto;
}

#report-export-fields,
#report-result-scroll {
    height: 1fr;
    overflow-y: auto;
}

#report-destination-input {
    width: 100%;
    height: 3;
}

#report-destination-validation {
    color: #f0bd60;
    height: auto;
    min-height: 1;
}

#report-restore-default {
    width: 18;
    height: 3;
}

#report-export-actions,
#report-overwrite-actions,
#report-result-actions {
    height: 3;
    align: right middle;
    margin-top: 1;
}

#report-export-actions Button,
#report-overwrite-actions Button,
#report-result-actions Button {
    min-width: 14;
    height: 3;
}

#report-export-confirm,
#report-overwrite-confirm,
#report-result-retry {
    margin-right: 1;
}

#export-advanced {
    width: 18;
    height: 3;
    margin-top: 0;
}

#export-actions,
#export-overwrite-actions,
#export-result-actions {
    height: 3;
    margin-top: 0;
    align: right middle;
}

#export-actions Button,
#export-overwrite-actions Button,
#export-result-actions Button {
    min-width: 14;
    height: 3;
    margin-left: 1;
}

#export-overwrite-card,
#export-result-card {
    height: auto;
}

#export-card {
    height: 100%;
}

#export-fields {
    height: 1fr;
    scrollbar-size: 1 1;
}

#export-overwrite-message,
#export-result-body,
#export-result-artifacts {
    color: #dbe7f2;
    height: auto;
    margin-bottom: 1;
}

#export-result-artifacts {
    color: #bcd0e0;
}

#review-title {
    color: #9da4ff;
    text-style: bold;
    height: 2;
    border-bottom: solid #25384b;
    margin-bottom: 1;
}

#review-body {
    height: 1fr;
    layout: horizontal;
}

#review-terminal,
#review-narrow {
    background: #050b11;
    border: round #29455f;
    color: #dbe7f2;
    padding: 1;
    overflow: hidden;
}

#review-terminal {
    width: 1fr;
    height: 1fr;
}

#review-sidebar {
    width: 36;
    margin-left: 1;
}

#review-timeline,
#review-captures {
    background: #0e1a26;
    border: round #29455f;
    color: #bcd0e0;
    padding: 1;
    height: auto;
    min-height: 7;
}

#review-captures {
    height: 1fr;
    margin-top: 1;
}

#review-footer {
    height: 1;
    color: #a5bacd;
    background: #101e2b;
    padding: 0 1;
    margin-top: 1;
}

#review-narrow {
    display: none;
    height: 1fr;
}

.narrow #review-body {
    display: none;
}

.narrow #review-narrow {
    display: block;
}

.wide #review-narrow {
    display: none;
}

#capture-title-dialog {
    align: center middle;
    background: rgba(0, 0, 0, 0.72);
}

#capture-title-card {
