    border: round #6d79e8;
    background: #101c29;
    padding: 1 2;
}

#pack-overwrite-heading,
#pack-result-heading {
    color: #9da4ff;
    text-style: bold;
    height: 2;
    margin-bottom: 1;
}

#pack-overwrite-message,
#pack-result-body {
    color: #dbe7f2;
    height: auto;
}

