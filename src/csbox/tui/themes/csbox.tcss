Screen {
    background: #08111a;
    color: #dbe7f2;
}

#home-layout {
    height: 100%;
    padding: 1 2 0 2;
}

#brand-block {
    height: auto;
    padding: 0 0 1 0;
    border-bottom: solid #25384b;
}

#brand-name {
    color: #8f95ff;
    text-style: bold;
    height: 1;
}

#brand-subtitle {
    color: #afc0d1;
    height: 1;
}

#brand-version {
    color: #70859a;
    height: 1;
}

#home-greeting {
    color: #e7f0f8;
    margin-top: 1;
    height: 1;
}

#home-description {
    color: #8ea5b9;
    height: 1;
}

#environment-panel,
#action-panel,
#recent-panel {
    background: #0e1a26;
    border: round #29455f;
    padding: 1;
}

#environment-panel {
    height: auto;
    margin-top: 1;
}

.panel-title {
    color: #6fc7e8;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#environment-content {
    color: #b3c5d6;
    height: auto;
}

#main-scroll {
    height: 1fr;
    margin-top: 1;
    padding-bottom: 1;
    scrollbar-size: 1 1;
}

#content-grid {
    height: auto;
    layout: vertical;
}

#action-panel,
#recent-panel {
    height: auto;
    margin-bottom: 1;
}

#recent-panel {
    min-height: 8;
}

.entry-button {
    width: 100%;
    height: 3;
    margin-bottom: 1;
    border: round #326fa2;
    background: #122335;
    color: #dbeeff;
}

.entry-button:hover {
    background: #19344c;
    color: #ffffff;
}

.entry-button:focus {
    border: tall #969dff;
    text-style: bold;
}

#demo-note {
    color: #f0bd60;
    height: auto;
    margin-bottom: 1;
}

#demo-count {
    color: #8da6ba;
    height: 1;
    margin-bottom: 1;
}

#recent-content {
    color: #c1d4e4;
    height: auto;
}

#shortcut-bar {
    height: 1;
    color: #a5bacd;
    background: #101e2b;
    padding: 0 1;
}

UnavailableDialog {
    align: center middle;
    background: rgba(0, 0, 0, 0.72);
}

#unavailable-dialog {
    width: 56;
    height: auto;
    border: round #6d79e8;
    background: #101c29;
    padding: 1 2;
}

#dialog-title {
    color: #9da4ff;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#dialog-message {
    color: #dbe7f2;
    height: auto;
    margin-bottom: 1;
}

#dialog-close {
    width: 100%;
    height: 3;
    border: round #326fa2;
    background: #162d43;
}

#dialog-close:focus {
    border: tall #f0bd60;
}

.wide #content-grid {
    layout: horizontal;
    height: 1fr;
}

.wide #action-panel {
    width: 2fr;
    height: 1fr;
    margin-right: 1;
    margin-bottom: 0;
}

.wide #recent-panel {
    width: 3fr;
    height: 1fr;
    margin-bottom: 0;
}

#review-layout {
    height: 100%;
    padding: 1 2 0 2;
}

#review-title {
    color: #9da4ff;
    text-style: bold;
    height: 1;
    border-bottom: solid #25384b;
    margin-bottom: 1;
}

#review-body {
    height: 1fr;
    layout: horizontal;
}

#review-terminal,
#review-narrow {
    background: #050b11;
    border: round #29455f;
    color: #dbe7f2;
    padding: 1;
    overflow: hidden;
}

#review-terminal {
    width: 1fr;
}

#review-sidebar {
    width: 36;
    margin-left: 1;
}

#review-timeline,
#review-captures {
    background: #0e1a26;
    border: round #29455f;
    color: #bcd0e0;
    padding: 1;
    height: auto;
    min-height: 7;
}

#review-captures {
    height: 1fr;
    margin-top: 1;
}

#review-footer {
    height: 1;
    color: #a5bacd;
    background: #101e2b;
    padding: 0 1;
    margin-top: 1;
}

#review-narrow {
    display: none;
    height: 1fr;
}

.narrow #review-body {
    display: none;
}

.narrow #review-narrow {
    display: block;
}

.wide #review-narrow {
    display: none;
}

#capture-title-dialog {
    align: center middle;
    background: rgba(0, 0, 0, 0.72);
}

#capture-title-card {
    width: 60;
    height: auto;
    border: round #6d79e8;
    background: #101c29;
    padding: 1 2;
}

#capture-title-heading {
    color: #9da4ff;
    text-style: bold;
    height: 1;
    margin-bottom: 1;
}

#capture-title-input {
    margin-bottom: 1;
}

#capture-title-actions {
    height: 3;
    align: right middle;
}

#capture-title-actions Button {
    min-width: 10;
    margin-left: 1;
}
