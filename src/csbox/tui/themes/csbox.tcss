.narrow #api-body {
    layout: vertical;
}

.narrow #api-scenarios,
.narrow #api-runs,
.narrow #api-detail {
    display: none;
    width: 1fr;
    height: 1fr;
    margin-left: 0;
}

.narrow.show-scenarios #api-scenarios,
.narrow.show-runs #api-runs,
.narrow.show-detail #api-detail {
    display: block;
}
