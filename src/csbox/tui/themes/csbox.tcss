    margin-left: 1;
}

.api-row {
    width: 100%;
    height: 3;
    margin-top: 1;
    border: round #326fa2;
    background: #122335;
    color: #dbeeff;
}

.api-row:hover {
    background: #19344c;
    color: #ffffff;
}

.api-row:focus {
    border: tall #969dff;
    text-style: bold;
}

.api-empty-action {
    width: 100%;
    min-height: 3;
    margin-top: 1;
    border: round #326fa2;
    background: #122335;
    color: #dbeeff;
}

.api-empty-action:focus {
    border: tall #969dff;
